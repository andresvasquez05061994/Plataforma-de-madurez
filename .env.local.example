NEXT_PUBLIC_SUPABASE_URL=
# Clave anon / publishable. Es pública por diseño. No pongas aquí la service_role.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role o Secret key (sb_secret_...). Solo servidor. Nunca NEXT_PUBLIC_.
# Supabase → Project Settings → API Keys.
SUPABASE_SERVICE_ROLE_KEY=
# Correos con acceso a /admin, separados por coma. Vacío = nadie entra.
# Incluye el correo de la cuenta de Google del administrador.
# El Client ID y el Client Secret de Google NO van aquí: se pegan en
# Supabase → Authentication → Providers → Google.
ADMIN_EMAILS=
OPENAI_API_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — Envío de correos
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Sheets — Preguntas dinámicas (opcional, usa estáticas como fallback)
# Cada hoja debe estar publicada: Archivo → Compartir → Publicar en la web → CSV
# El valor es solo el ID de la hoja (la parte entre /d/ y /edit en la URL)
GOOGLE_SHEET_BIM=17lKxYdy7LaPh0BOKSLk86FxZH3gp2mOaHpXtwqhZy74
GOOGLE_SHEET_BIM_GID=0
GOOGLE_SHEET_IA=1TbhGmAMzxSUSwo35sfGFZ8TnGjnkRhD17q9N2R7JVGI
GOOGLE_SHEET_IA_GID=0
